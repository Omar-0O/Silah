<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/widget_item_background"
    android:padding="8dp"
    android:gravity="center_vertical">

    <!-- Quick Action Buttons on Left -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginRight="8dp">

        <!-- Quick WhatsApp Button -->
        <ImageView
            android:id="@+id/widget_item_chat"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_chat_button_background"
            android:src="@drawable/ic_widget_chat"
            android:padding="7dp"
            android:contentDescription="مراسلة واتساب"
            android:layout_marginRight="6dp" />

        <!-- Quick Call Button -->
        <ImageView
            android:id="@+id/widget_item_call"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_button_background"
            android:src="@drawable/ic_widget_call"
            android:padding="7dp"
            android:contentDescription="اتصال هاتف" />
    </LinearLayout>

    <!-- Relative Information (Right Aligned for RTL) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="right"
        android:layout_marginLeft="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_item_degree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_tag_background"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="والدان"
                android:textColor="#2D5A3D"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginRight="6dp" />

            <TextView
                android:id="@+id/widget_item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اسم القريب"
                android:textColor="#1C221E"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_item_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="آخر تواصل: منذ ٥ أيام"
            android:textColor="#5A7A66"
            android:textSize="10.5sp"
            android:layout_marginTop="2dp"
            android:maxLines="1" />
    </LinearLayout>

</LinearLayout>
